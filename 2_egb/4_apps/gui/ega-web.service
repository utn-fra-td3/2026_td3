[Unit]
Description=Panel web de la fuente partida EGA
After=network.target

[Service]
Type=simple
User=pi
Group=dialout
WorkingDirectory=/home/pi/ega-egb-zero/4_apps/gui
ExecStart=/usr/bin/python3 /home/pi/ega-egb-zero/4_apps/gui/ega_web.py --host 0.0.0.0 --port 8080 --device /dev/ega_uart
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
